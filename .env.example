# ---------------------------------------------------------------------------
# Clash — environment
#
# Copy to `.env.local` for development. Set the same keys in the Vercel project
# for preview and production. Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Public (shipped to the browser) ---------------------------------------

# 42220 = Celo mainnet, 11142220 = Celo Sepolia.
NEXT_PUBLIC_CHAIN_ID=42220

# Deployed ClashArena address. Leave empty and the app runs practice-only.
NEXT_PUBLIC_CLASH_ADDRESS=

# Block the contract was deployed in. Lets /stats scan from the right place instead of
# guessing at the last week of blocks.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional dedicated RPC. Falls back to Forno, which is rate-limited.
NEXT_PUBLIC_RPC_URL=

# Tournament entry price, as a decimal string in the entry token.
NEXT_PUBLIC_ENTRY_PRICE=0.25

# In-app support link. Telegram, WhatsApp, email or a web portal — MiniPay requires one.
NEXT_PUBLIC_SUPPORT_URL=https://t.me/clasharena

# --- Server only -----------------------------------------------------------

# Operator key allowed to open and settle tournaments. Fund it with a little CELO for
# network fees. This key cannot take player funds — see the trust note in the README.
SETTLER_PRIVATE_KEY=

# Optional: pay the settler's own network fees in a stablecoin instead of CELO.
# Use the fee-currency ADAPTER address for USDC/USDT.
SETTLER_FEE_CURRENCY=

# Shared secret guarding /api/settle and /api/cron/settle. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Durable score store. Without these the app falls back to an in-process map, which does
# not survive a restart and is not shared between serverless instances — development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contracts (Foundry, contracts/) ---------------------------------------

DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
SETTLER_ADDRESS=
OWNER_ADDRESS=
CELOSCAN_API_KEY=
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
