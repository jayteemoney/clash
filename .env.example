# ---------------------------------------------------------------------------
# Clash — environment
#
# Copy to `.env.local` for development. Set the same keys in the Vercel project
# for preview and production. Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Public (shipped to the browser) ---------------------------------------

# 42220 = Celo mainnet, 11142220 = Celo Sepolia.
NEXT_PUBLIC_CHAIN_ID=42220

# Deployed ClashArena address. Leave empty and the app runs practice-only.
NEXT_PUBLIC_CLASH_ADDRESS=

# Block the contract was deployed in. Lets /stats scan from the right place instead of
# guessing at the last week of blocks.
NEXT_PUBLIC_DEPLOY_BLOCK=

# Optional dedicated RPC. Falls back to Forno, which is rate-limited.
NEXT_PUBLIC_RPC_URL=

# Tournament entry price, as a decimal string in the entry token.
NEXT_PUBLIC_ENTRY_PRICE=0.25

# Which stablecoin entries and duel stakes are denominated in: USDm, USDC or USDT.
# Defaults to USDm. On Celo Sepolia set this to USDC — it is the only one of the three you can
# actually obtain there (https://faucet.circle.com lists Celo Sepolia; USDm is not mintable and
# has no working Mento route on that network).
NEXT_PUBLIC_ENTRY_TOKEN=USDm

# In-app support link. Telegram, WhatsApp, email or a web portal — MiniPay requires one.
NEXT_PUBLIC_SUPPORT_URL=https://t.me/clasharena

# --- Server only -----------------------------------------------------------

# Operator key allowed to open and settle tournaments. Fund it with a little CELO for
# network fees. This key cannot take player funds — see the trust note in the README.
SETTLER_PRIVATE_KEY=

# Optional: pay the settler's own network fees in a stablecoin instead of CELO.
# Use the fee-currency ADAPTER address for USDC/USDT.
SETTLER_FEE_CURRENCY=

# Shared secret guarding /api/settle and /api/cron/settle. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Product analytics (PostHog). Without a key every track() call is a no-op, so development
# and the test suite need no account. Anonymous only — no wallet address is ever sent.
# NEXT_PUBLIC_ANALYTICS_URL is the shareable dashboard, linked from /stats.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ANALYTICS_URL=

# Durable score store. Without these the app falls back to an in-process map, which does
# not survive a restart and is not shared between serverless instances — development only.
# Provision: `vercel integration accept-terms upstash` (interactive, once) then
#            `vercel integration add upstash/upstash-kv --name clash-scores`.
# Verify:    `npm run check:store` — a real write/read/TTL/delete round-trip, not a config check.
#
# The marketplace injects KV_REST_API_URL / KV_REST_API_TOKEN instead of the names below, and the
# app reads either spelling. Set these two only when provisioning Upstash by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contracts (Foundry, contracts/) ---------------------------------------

DEPLOYER_PRIVATE_KEY=
TREASURY_ADDRESS=
SETTLER_ADDRESS=
OWNER_ADDRESS=

# From etherscan.io, NOT celoscan.io. Verification goes through the Etherscan V2 API, which covers
# every chain from one host — Celo's own V1 endpoints are deprecated and reject requests. The
# verified source still shows up on Celoscan.
ETHERSCAN_API_KEY=

CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
